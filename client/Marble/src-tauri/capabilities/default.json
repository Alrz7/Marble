{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:allow-fetch-send",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:**" },
        { "url": "http://**" },
        { "url": "https://**" }
      ]
    },
    "opener:default",
    "keyring:default",
    "sql:default",
    "sql:allow-execute",
    "clipboard-manager:default",
    "clipboard-manager:allow-write-text"
  ]
}
