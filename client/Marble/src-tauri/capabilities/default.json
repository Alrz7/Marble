{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://localhost:6280/account"
        }
      ],
      "deny": [
        {
          "url": "https://private.tauri.app"
        }
      ]
    },
    "core:default",
    "store:default",
    "opener:default",
    "keyring:default",
    "stronghold:default",
    "sql:default",
    "sql:allow-execute"
  ]
}
